[Desktop Entry]
Name=Super Voice
Comment=Speech to text and text to speech
Type=Application
Icon=super-voice-app
Exec=super-voice-app
Terminal=false
StartupNotify=true
# Must match APP_ID in super-voice-gpui/src/lib.rs: the window announces
# that as its Wayland app_id, and it differs from this file's name.
StartupWMClass=org.superlibre.SuperVoice
Categories=AudioVideo;Audio;
Keywords=speech;transcription;dictation;stt;synthesis;tts;voice;audio;speech-to-text;text-to-speech;
MimeType=
