{
  "description": "Read Claude's replies aloud, say when it needs approval, and fall silent when you send the next prompt.",
  "modules": ["./register.tsx"],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.last_assistant_message // empty' | voice speak >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // empty' | voice speak >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "voice speak stop >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ]
  }
}
