{
  "description": "Say when Claude Code needs you, and fall silent when you send the next prompt. The module reads replies to spoken prompts aloud.",
  "modules": ["./register.tsx"],
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.message // empty' | voice speak >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "voice speak stop >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ]
  }
}
